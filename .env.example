# Supabase project URL and publishable/anon key. These browser-visible values are
# not service-role secrets; access must still be protected by RLS and server checks.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# The server validates bearer tokens with the same project and publishable key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
PORT=3000
