# Use a separately approved, independent NutritionMath Supabase project.
# Values are deliberately blank: no shared-project credentials are provided.
#
# Vite embeds all VITE_ values in the browser build. Use ONLY a publishable
# (sb_publishable_...) or legacy anon key here; NEVER a secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server runtime: use the same independent project URL and a publishable/anon
# key from that project. These variables do not require privileged credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional Express listener port. Development proxy uses the same PORT.
PORT=3000
